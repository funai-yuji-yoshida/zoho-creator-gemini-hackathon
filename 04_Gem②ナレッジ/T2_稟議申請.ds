/*
 * Author       : funaiindia
 * Generated on : 28-Apr-2026 00:42:45
 * Version      : 1.0
 */
 application "稟議申請アプリ"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form ringi_requests
		{
			displayname = "稟議申請フォーム"
			success message = "データが正常に追加されました！"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have applicant
			(
    			type = picklist
				displayname = "申請者"
				module = users
				displayformat = [username]
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have ringi_title
			(
    			type = text
				displayname = "稟議タイトル"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have ringi_category
			(
				type = picklist
				displayname = "稟議カテゴリ"
				values = {"契約申請","購入申請","採用申請","その他"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have reason
			(
    			type = textarea
				displayname = "申請理由"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			planned_date
			(
    			type = date
				displayname = "実施予定日"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			attachment
			(
    			type = upload file
				displayname = "添付ファイル"
    			file count = 10
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "ステータス"
				values = {"申請中","承認待ち","差し戻し","承認済み"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "備考"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have application_date
			(
    			type = date
				displayname = "申請日"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have request_amount
			(
				displayname = "申請金額"
				type = JPY
	 			row = 1
	 			column = 2   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "承認セクション"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			approval_result
			(
				type = picklist
				displayname = "承認結果"
				maxchar = 100
				values = {"承認","差し戻し","その他"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			approval_comment
			(
    			type = textarea
				displayname = "承認コメント"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			approver_name
			(
    			type = picklist
				displayname = "承認者名"
				module = users
				displayformat = [username]
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			approved_at
			(
    			type = datetime
				displayname = "承認日時"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "提出"
					)
					reset
					(
   						type = reset
   						displayname = "リセット"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "更新"
					)
					cancel
					(
   						type = cancel
   						displayname = "キャンセル"
					)
				}
			}
			blueprint components
			{
				stages = {"申請作成","承認依頼","申請保留","承認済み","却下","補足情報要求","実施予定","承認取り消し","再申請","申請終了","実施完了","実施延期"}
			}
		}
	}
	reports
	{
		list ringi_requests_Report
		{
			displayName = "稟議依頼レポート"
			show all rows from ringi_requests    
			(
				application_date as "申請日"
				ringi_title as "稟議タイトル"
				ringi_category as "稟議カテゴリ"
				request_amount as "申請金額"
				(
					display = total,average,min,max	
				)
				planned_date as "実施予定日"
				reason as "申請理由"
				status as "ステータス"
				remarks as "備考"
				approval_comment as "承認コメント"
				approved_at as "承認日時"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (ringi_category == "その他")
				fields = [ringi_category]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (ringi_category == "契約申請")
				fields = [ringi_category]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (ringi_category == "購入申請")
				fields = [ringi_category]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
	}




	share_settings
	{
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"申請者"
			{
				name = "申請者"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "稟議申請フォームを入力して新規申請を提出する \n"
				ModulePermissions
				{
					ringi_requests
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							ringi_requests_Report={"View","Edit"}
						}
					}
				}
			}
			"承認者"
			{
				name = "承認者"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "承認待ちの稟議申請を確認し、承認または差し戻しを行う \n"
				ModulePermissions
				{
					ringi_requests
					{
						enabled= Viewall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							ringi_requests_Report={"View","Edit"}
						}
					}
				}
			}
			"管理者"
			{
				name = "管理者"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "稟議申請の全体的な状況を監視し、統計データを生成する \n"
				ModulePermissions
				{
					ringi_requests
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							ringi_requests_Report={"View","Edit","Delete"}
						}
					}
				}
			}
			"外部ベンダー"
			{
				name = "外部ベンダー"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "購入申請に伴う商品やサービスの提供情報を提供する \n"
				ModulePermissions
				{
					ringi_requests
					{
						enabled= Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							ringi_requests_Report={"View","Edit"}
						}
					}
				}
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			"外部協力会社担当者"
			{
				name = "外部協力会社担当者"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "契約申請に関する資料を提出し、申請を推進する \n"
				ModulePermissions
				{
					ringi_requests
					{
						enabled= Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							ringi_requests_Report={"View","Edit"}
						}
					}
				}
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


	web
	{
		forms
		{
			form ringi_requests
			{
				label placement = left
			}
		}
		reports
		{
			report ringi_requests_Report
			{
				quickview
				(
					layout
					(
		 				type = -1
						datablock1
						(
							layout type = -1
							fields
							(
								application_date as "申請日"
								ringi_title as "稟議タイトル"
								ringi_category as "稟議カテゴリ"
								request_amount as "申請金額"
								planned_date as "実施予定日"
								reason as "申請理由"
								status as "ステータス"
								remarks as "備考"
								approval_comment as "承認コメント"
								approved_at as "承認日時"
							)
						)
					)
					menu
    				(
    	 				header
    	 				(
    		 				Edit  as "編集" 
    		 				Duplicate  as "複製" 
    		 				Delete  as "削除" 
    		 				Print  as "印刷" 
    		 				Add 
    		 				Import 
    		 				Export 
    	 				)
						record
						(
							Edit  as "編集"   	   
							Duplicate  as "複製"   	   
							Delete  as "削除"   	   
							Print  as "印刷"   	   
    					)
    				)
    				action
    				(
						on click
						(
							View Record  as "レコードを表示"   	   
    					)
						on right click
						(
							Edit  as "編集"   	   
							Duplicate  as "複製"   	   
							Delete  as "削除"   	   
							Print  as "印刷"   	   
							View Record  as "レコードを表示"   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 1
						datablock1
						(
							layout type = -2
		     				title = "概要"
							fields
							(
								application_date as "申請日"
								ringi_title as "稟議タイトル"
								ringi_category as "稟議カテゴリ"
								request_amount as "申請金額"
								planned_date as "実施予定日"
								reason as "申請理由"
								status as "ステータス"
								remarks as "備考"
								approval_comment as "承認コメント"
								approved_at as "承認日時"
							)
						)
					)
					menu
    				(
    	 				header
    	 				(
    		 				Edit  as "編集" 
    		 				Duplicate  as "複製" 
    		 				Delete  as "削除" 
    		 				Print  as "印刷" 
    	 				)
    				)
				)
			}
		}
		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Section_2
				{
					displayname = "稟議依頼"
					icon = "business-laptop-71"
					form  ringi_requests
					{
						icon = "ui-1-bold-add"
					}
					report ringi_requests_Report
					{
						icon = "business-laptop-71"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
			}
			preference
			{
				icon
				{
					style = solid
					show = {space,section,component}
				}
			}
		}
		customize
		{
			new theme = 4
			font = "lato"
			color options
			{
				color = "5"
			}
			logo
			{
				preference = "none"
				placement = "left"
			}
		}
	}
	phone
	{
		forms
		{
			form ringi_requests
			{
				label placement = auto
			}
		}
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = turquoise
			}
			logo
			{
				preference = "company_logo"
			}
		}
	}
	tablet
	{
		forms
		{
			form ringi_requests
			{
				label placement = auto
			}
		}
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = turquoise
			}
			logo
			{
				preference = "company_logo"
			}
		}
	}
	translation
{
{"Language_Settings":{"LANGAGUE_WITH_LOGIN":"browser"}}
}
}
